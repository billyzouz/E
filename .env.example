# --- Accès au tableau de bord (protection basique) ---
ADMIN_PASSWORD=change-moi

# --- URL publique de l'appli (sans / final) ---
APP_URL=http://localhost:3000

# --- eBay ---
# "sandbox" pour tester, "production" pour le vrai eBay
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Le "RuName" créé dans User Tokens (ce n'est PAS une URL)
EBAY_RUNAME=
EBAY_MARKETPLACE_ID=EBAY_FR
EBAY_CURRENCY=EUR
EBAY_CONTENT_LANGUAGE=fr-FR
# Politiques vendeur (créées dans ton compte eBay : livraison, paiement, retours)
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=
# Notification de suppression de compte (obligatoire pour les clés Production)
# Token de 32 à 80 caractères (lettres, chiffres, _ et -), à inventer et recopier côté eBay
EBAY_DELETION_VERIFICATION_TOKEN=

# --- CJ Dropshipping ---
CJ_API_KEY=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Tâches planifiées (protège /api/cron/*) ---
CRON_SECRET=

# --- Règles de prix ---
PRICING_TARGET_MARGIN=0.20
PRICING_EBAY_FEE_RATE=0.13
PRICING_EBAY_FIXED_FEE=0.35
PRICING_MIN_PROFIT=3

# --- Devise (CJ facture en USD) ---
USD_TO_EUR_RATE=0.95
# Pays de l'entrepôt CJ d'expédition (CN = Chine, FR/DE/ES si stock local)
CJ_FROM_COUNTRY=CN
CJ_MIN_GAP_MS=1100
