# --- Accès au tableau de bord (protection basique) ---
ADMIN_PASSWORD=change-moi

# --- URL publique de l'appli (sans / final) ---
APP_URL=http://localhost:3000

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Tâches planifiées (protège /api/cron/*) ---
CRON_SECRET=

# --- CJ Dropshipping ---
CJ_API_KEY=
# Écart minimum entre deux appels CJ (limite : 1 appel/s)
CJ_MIN_GAP_MS=1100
# true = les commandes CJ sont payées automatiquement avec ton solde CJ.
# Sinon elles sont créées non payées et tu les paies à la main sur CJ.
CJ_AUTO_PAY=false

# --- IA : rédaction des annonces dans la langue de chaque pays ---
# Clé OpenRouter (openrouter.ai → Keys). Modèle par défaut : DeepSeek V4.1 Flash.
AI_API_KEY=
AI_MODEL=deepseek/deepseek-v4.1-flash
# AI_BASE_URL=https://openrouter.ai/api/v1

# --- eBay ---
# "sandbox" pour tester, "production" pour le vrai eBay
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Le "RuName" créé dans User Tokens (ce n'est PAS une URL)
EBAY_RUNAME=
# Notification de suppression de compte (obligatoire pour les clés Production)
# Token de 32 à 80 caractères (lettres, chiffres, _ et -), à inventer et recopier côté eBay
EBAY_DELETION_VERIFICATION_TOKEN=

# --- Pays ---
# Marchés eBay actifs, séparés par des virgules. Vide = les 8.
# EBAY_US, EBAY_GB, EBAY_DE, EBAY_FR, EBAY_IT, EBAY_ES, EBAY_AU, EBAY_CA
ENABLED_MARKETS=
# Un pays est écarté pour un produit si aucun entrepôt CJ ne livre en moins de N jours
MAX_DELIVERY_DAYS=20

# --- Règles de prix (devise de chaque pays) ---
PRICING_TARGET_MARGIN=0.20
PRICING_EBAY_FEE_RATE=0.13
PRICING_MIN_PROFIT=3
# Marge de sécurité sur le taux de change USD → devise locale
FX_SAFETY=0.03
